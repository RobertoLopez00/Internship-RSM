JWT_KEY=change-this-to-a-random-secret-of-at-least-32-chars
BOOTSTRAP_ADMIN_EMAIL=admin@dentalcare.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!

# On first run against an empty database, sample data (services, doctors,
# patients, appointments, treatments, and extra Doctor/Receptionist users)
# is created automatically. Set to false to start with an empty database
# (only the bootstrap admin above will be created).
SEED_SAMPLE_DATA=true

# By default, docker-compose sends email through the bundled Mailpit container
# (no real SMTP credentials needed — view sent emails at http://localhost:8025).
# To use a real SMTP provider instead, override these:
EMAIL_ENABLED=true
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_SSL=false
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@dentalcare.com

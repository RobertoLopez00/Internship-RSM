# Required. Signs every login token: anyone who knows it can sign in as Admin. Generate your own with
#   openssl rand -base64 48
# The API refuses to start without it or with an example value.
JWT_KEY=

# Password of the bundled SQL Server container (sa). It must meet SQL Server's complexity rules.
SQL_SA_PASSWORD=YourPassword123

BOOTSTRAP_ADMIN_EMAIL=admin@dentalcare.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!

# On first run against an empty database, sample data (services, doctors,
# patients, appointments, treatments, and extra Doctor/Receptionist users)
# is created automatically. Set to false to start with an empty database
# (only the bootstrap admin above will be created).
SEED_SAMPLE_DATA=true

# Clinic time zone (IANA id, e.g. America/Mexico_City, Europe/Madrid). Opening hours, "today" on the
# dashboard and the times in emails all use it. The container's own zone is UTC.
CLINIC_TIMEZONE=UTC
CLINIC_OPEN_HOUR=9
CLINIC_CLOSE_HOUR=18
CLINIC_CURRENCY=USD
# Where contact-form messages go. Empty means EMAIL_FROM.
CLINIC_CONTACT_EMAIL=

# By default, docker-compose sends email through the bundled Mailpit container
# (no real SMTP credentials needed — view sent emails at http://localhost:8025).
# To use a real SMTP provider instead, override these:
EMAIL_ENABLED=true
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_SSL=false
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@dentalcare.com
